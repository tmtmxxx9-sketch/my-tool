# スプレッドシート ID（URL の /d/ と /edit の間）または URL 全文のどちらか
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/【ここにID】/edit

# ワークシート名（日本語シートの場合は「シート1」など。見つからない場合は先頭シートを使用）
GOOGLE_SHEETS_WORKSHEET=シート1

# ローカル: todo-sheets/credentials.json（サービスアカウント鍵）
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# 本番（Render 等）: JSON 全文を 1 行で（credentials.json の代わり）
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

FLASK_SECRET_KEY=change-me-in-production
PORT=5000

# 起動前に python verify_sheets.py と同等の疎通テストを実行（任意）
# TODO_SHEETS_VERIFY_ON_START=1
