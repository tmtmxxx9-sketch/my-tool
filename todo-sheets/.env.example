# スプレッドシート ID（URL の /d/ と /edit の間）または URL 全文のどちらか
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/【ここにID】/edit

# ワークシート名（日本語シートの場合は「シート1」など。見つからない場合は先頭シートを使用）
GOOGLE_SHEETS_WORKSHEET=シート1

# todo-sheets/credentials.json（サービスアカウント鍵）
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

FLASK_SECRET_KEY=change-me-in-production
PORT=5000
